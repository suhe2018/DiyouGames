<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".ui.ResultActivity">

    <!-- Result Title -->
    <TextView
        android:id="@+id/tvResultTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="36sp"
        android:textColor="@color/accent_gold"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:shadowColor="@color/primary_variant"
        android:shadowRadius="16"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="战士 胜利！" />

    <TextView
        android:id="@+id/tvResultSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="monospace"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvResultTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="P1 获胜" />

    <!-- Round Score -->
    <TextView
        android:id="@+id/tvRoundScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="48sp"
        android:textColor="@color/text_primary"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvResultSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="2  :  1" />

    <!-- Stats card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/statsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvRoundScore"
        app:layout_constraintBottom_toTopOf="@id/btnRematch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvP1Stats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="@color/p1_color"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.4"
                tools:text="战士\n回合胜利: 2\n总伤害: 320" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/surface_variant"
                android:layout_marginHorizontal="12dp" />

            <TextView
                android:id="@+id/tvP2Stats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="@color/p2_color"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.4"
                tools:text="武僧\n回合胜利: 1\n总伤害: 210" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRematch"
        style="@style/Widget.DiyouGames.PixelButton"
        android:layout_width="180dp"
        android:layout_height="52dp"
        android:text="⚔  再来一局"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        app:backgroundTint="@color/secondary"
        app:layout_constraintBottom_toTopOf="@id/btnMainMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMainMenu"
        style="@style/Widget.DiyouGames.PixelButton"
        android:layout_width="180dp"
        android:layout_height="46dp"
        android:text="🏠 主菜单"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
