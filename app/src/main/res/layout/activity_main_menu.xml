<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".ui.MainMenuActivity">

    <!-- Background decorative pixel grid -->
    <View
        android:id="@+id/bgGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_pixel_grid"
        android:alpha="0.3" />

    <!-- Logo / Title -->
    <LinearLayout
        android:id="@+id/logoContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/menuContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/logoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PIXEL DUEL"
            android:textSize="48sp"
            android:textColor="@color/accent_gold"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:shadowColor="@color/primary_variant"
            android:shadowRadius="12"
            android:shadowDx="3"
            android:shadowDy="3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PIXEL DUEL"
            android:textSize="16sp"
            android:textColor="@color/secondary"
            android:fontFamily="monospace"
            android:letterSpacing="0.3"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Menu Buttons -->
    <LinearLayout
        android:id="@+id/menuContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoContainer">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVsAi"
            style="@style/Widget.DiyouGames.PixelButton"
            android:layout_width="220dp"
            android:layout_height="56dp"
            android:text="⚔  Single Player"
            android:textSize="16sp"
            android:layout_marginBottom="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVsPlayer"
            style="@style/Widget.DiyouGames.PixelButton"
            android:layout_width="220dp"
            android:layout_height="56dp"
            android:text="⚔  Local 2-Player"
            android:textSize="16sp"
            android:layout_marginBottom="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            style="@style/Widget.DiyouGames.PixelButton"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:text="⚙  Settings"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Version -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0.0"
        android:textSize="10sp"
        android:textColor="@color/text_hint"
        android:fontFamily="monospace"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
