<?xml version="1.0" encoding="utf-8"?>
<!--
    Google Play compliance: Data extraction rules for Android 12+.
    This game stores only local preferences (sound settings, scores).
    No personal data is collected or transmitted.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Allow backing up game settings and high scores -->
        <include domain="sharedpref" path="diyou_prefs.xml" />
        <!-- Exclude any cache -->
        <exclude domain="cache" />
        <exclude domain="external-cache" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="diyou_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
